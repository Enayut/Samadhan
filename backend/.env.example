# SAMAADHAN backend environment
# Copy to .env and adjust for your environment.

# App
APP_NAME=SAMAADHAN
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (async PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/samaadhan

# Auth
SECRET_KEY=change-me-in-production
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS — keep ["*"] in development only
CORS_ALLOWED_ORIGINS=["*"]

# Feature flags
DEMO_MODE=false
OCR_ENABLED=true
AI_ENABLED=true
PGVECTOR_AVAILABLE=true

# AI / RAG (app/services/rag) — Gemini is only used when a key is present.
# GEMINI_API_KEY=your-key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-2.0-flash
# auto | local | gemini   (auto = gemini when a key is present, else local)
RAG_EMBEDDING_BACKEND=auto
# embedded | pgvector   (embedded works on any DB; pgvector needs the PG extension)
RAG_VECTOR_BACKEND=embedded
# Empty -> <repo>/data (RAG_CORPUS.md + bundled PDFs)
RAG_DATA_DIR=
# Index the 18-doc corpus automatically when the app starts and the index is empty
RAG_AUTO_INDEX_ON_START=false
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=120
